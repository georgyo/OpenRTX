# udev rules for radios supported by OpenRTX (DFU mode and USB serial)
# Place this in /etc/udev/rules.d/ to let non-root users talk to the radios.

# GDx family (example: Radioddity GD77)
SUBSYSTEM=="usb", ATTRS{idVendor}=="15a2", ATTRS{idProduct}=="0073", MODE="0666"
# MDx family (example: Tytera MD380)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666"
# Module17 (GigaDevice GD32 support)
SUBSYSTEM=="usb", ATTRS{idVendor}=="28e9", ATTRS{idProduct}=="0189", MODE="0666"

# OpenRTX USB CDC serial console (CS7000-M17 Plus): ST VID with tinyUSB's
# auto-generated CDC PID. The tty is already accessible through the dialout
# group; this only stops ModemManager from probing it after plug-in.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="4001", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="4001", ENV{ID_MM_DEVICE_IGNORE}="1"
